# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]          # .pyc  .pyo  .pyd
*.pyo
*.pyd

# virtual environments
.venv/
venv/
env/
.env/

# distribution / packaging
dist/
build/
*.egg-info/
*.egg

# ── Secrets & environment ──────────────────────────────────────────────────────
.env
.env.*
!.env.example      # allow a committed example if one is added later

# ── Generated by update_profile.py ────────────────────────────────────────────
# Atomic write temporaries (path.suffix + '.tmp')
assets/*.svg.tmp
README.md.tmp
*.tmp

# ── Editor / IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Misc ───────────────────────────────────────────────────────────────────────
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
